{
  "name": "@itwin/presentation-rules-editor-react",
  "description": "iTwin.js Presentation Rules Editor React components",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy",
    "copy": "cpx \"./src/**/*.*css\" ./lib/src",
    "test": "cross-env NODE_OPTIONS=\"--import ../node-hooks/ignore-styles.cjs\" vitest run",
    "test:cover": "npm test -- --coverage",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "release": "ts-node --transpile-only ../scripts/src/finalizeRelease.ts"
  },
  "license": "MIT",
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "https://www.bentley.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/presentation-rules-editor/tree/master/presentation-rules-editor-react"
  },
  "keywords": [
    "Bentley",
    "BIM",
    "iModel",
    "iTwin",
    "EC",
    "Presentation",
    "Rules"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "sideEffects": [
    "*.scss"
  ],
  "peerDependencies": {
    "@itwin/appui-abstract": "^5.0.0",
    "@itwin/components-react": "^5.0.0",
    "@itwin/core-bentley": "^5.0.0",
    "@itwin/core-common": "^5.0.0",
    "@itwin/core-frontend": "^5.0.0",
    "@itwin/core-i18n": "^5.0.0",
    "@itwin/core-quantity": "^5.0.0",
    "@itwin/imodel-components-react": "^5.0.0",
    "@itwin/itwinui-react": "^3.0.0",
    "@itwin/presentation-common": "^5.0.0",
    "@itwin/presentation-components": "^5.0.0",
    "@itwin/presentation-frontend": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@itwin/appui-abstract": "catalog:itwinjs-core",
    "@itwin/components-react": "catalog:appui",
    "@itwin/core-bentley": "catalog:itwinjs-core",
    "@itwin/core-common": "catalog:itwinjs-core",
    "@itwin/core-frontend": "catalog:itwinjs-core",
    "@itwin/core-i18n": "catalog:itwinjs-core",
    "@itwin/core-quantity": "catalog:itwinjs-core",
    "@itwin/eslint-plugin": "catalog:build-tools",
    "@itwin/imodel-components-react": "catalog:appui",
    "@itwin/itwinui-react": "catalog:itwinui",
    "@itwin/presentation-common": "catalog:itwinjs-core",
    "@itwin/presentation-components": "catalog:",
    "@itwin/presentation-frontend": "catalog:itwinjs-core",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:build-tools",
    "@types/react": "catalog:react",
    "@vitest/coverage-v8": "^4.1.12",
    "cpx2": "catalog:build-tools",
    "cross-env": "catalog:build-tools",
    "eslint": "catalog:build-tools",
    "eslint-plugin-react": "catalog:build-tools",
    "jsdom": "^27.4.0",
    "monaco-editor": "catalog:",
